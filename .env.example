# Copy this file to .env and fill in real values.
# Never commit .env or paste real secrets into this file — see
# "CI-CD Pipeline Manual.md" for why that matters.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carescot?schema=public"

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Must be at least 32 characters — the app refuses to boot otherwise (src/env.ts).
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── Field-level encryption ──────────────────────────────────────────────────
# AES-256-GCM key for encrypting niNumber (StaffMember/ServiceUser) and
# hourlyRate (StaffMember) at the app layer — src/lib/encryption.ts.
# Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes — the app refuses to boot otherwise
# (src/env.ts). Rotating this key makes existing encrypted values
# undecryptable, so treat it like AUTH_SECRET: back it up, never commit it.
ENCRYPTION_KEY=""

# ─── File storage ────────────────────────────────────────────────────────────
# LOCAL writes to disk (fine for local dev only — does not survive a
# redeploy/restart in production). S3 is required in any real deployment.
FILE_STORAGE_PROVIDER="LOCAL"

# Required when FILE_STORAGE_PROVIDER=S3:
# S3_BUCKET_NAME=""
# AWS_REGION="eu-west-2"
# In production, prefer an App Runner instance role over static keys.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Only for pointing at an S3-compatible service (e.g. MinIO) during local
# development/testing — leave unset in production.
# S3_ENDPOINT="http://localhost:9000"
# S3_FORCE_PATH_STYLE="true"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Bearer token that authorizes calls to /api/cron/check-compliance.
# Required in production — the compliance-deadline reminder job silently
# never runs without it (the endpoint fails closed if unset).
# CRON_SECRET=""

# ─── Error tracking (Sentry) ─────────────────────────────────────────────────
# Both unset = SDK no-ops everywhere (safe default for local dev). Set both
# to the same DSN from your Sentry project once one exists.
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# Only needed in CI/production for source-map upload during build (readable
# stack traces in Sentry) — build succeeds without these, just skips upload.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# ─── Email (AWS SES) ─────────────────────────────────────────────────────────
# Unset = password-reset emails are logged to the console instead of sent
# (safe default for local dev). Must be a verified sender identity/domain in
# SES, and SES must be out of sandbox mode before real users can receive mail.
# SES_FROM_ADDRESS="noreply@yourdomain.com"
# Only for pointing at a local mock SES endpoint during testing — leave unset
# in production.
# SES_ENDPOINT="http://localhost:9999"

# ─── Self-serve signup (CAPTCHA) ─────────────────────────────────────────────
# Cloudflare Turnstile — unset = CAPTCHA is skipped entirely on both the
# widget (client) and verification (server) side. Fine for local dev, but
# set both in production or /signup has no bot protection beyond rate limiting.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs for the 5-seat block, set up in the Stripe Dashboard — the app
# never hardcodes real prices, just references these.
# STRIPE_PRICE_MONTHLY_BLOCK=""
# STRIPE_PRICE_ANNUAL_BLOCK=""

# ─── E2E testing only ────────────────────────────────────────────────────────
# Captures "sent" emails to a file so the Playwright suite can read
# verification/reset links without a real inbox. Leave unset outside of
# running the e2e suite — never set this in production.
# EMAIL_CAPTURE_FILE="e2e/.emails/captured.jsonl"
